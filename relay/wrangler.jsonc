{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pre-gemini-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  // Serve only the single workers.dev URL; per-version preview URLs would add
  // extra public endpoints for this credential-handling Worker.
  "preview_urls": false,
  "vars": {
    // An origin has no /PRE1.5.1/ path or trailing slash.
    "ALLOWED_ORIGIN": "https://8ry8.github.io",
    // Stable generateContent model that Google offers to new API keys (Oct 2026).
    // gemini-2.5-* models now return "not found" for keys that never used them.
    // Change this if Google retires the model or your key lacks access to it.
    "GEMINI_MODEL": "gemini-3.8-flash",
    // Tried once, automatically, only when the primary model fails on the
    // provider side (unavailable, rejected, or an unreadable reply) — never on a
    // quota/rate-limit 429, a safety block, or a timeout. Both models accept the
    // relay's fixed `low` thinking level, and the two attempts share one 180s
    // server budget, so a fallback cannot double the wait. Remove this line (or
    // set it to "") to go back to a single model with no fallback.
    // Flash-Lite's own default is the even lighter `minimal`.
    "GEMINI_FALLBACK_MODEL": "gemini-3.5-flash-lite"
  },
  "ratelimits": [
    {
      "name": "GEMINI_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Do not collect prompts or credentials in application logs.
  "observability": { "enabled": false }
  // GEMINI_API_KEY and RELAY_ACCESS_TOKEN are secrets, never vars here.
}
